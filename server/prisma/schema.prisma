generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENTE
  TECNICO
}

enum RequestStatus {
  PENDIENTE
  DISPONIBLE
  EN_PROCESO
  ATENDIDA
  CANCELADA
}

enum RequestPriority {
  BAJA
  MEDIA
  ALTA
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  password         String?
  role             Role               @default(CLIENTE)
  isActive         Boolean            @default(true)
  googleId         String?            @unique
  avatarUrl        String?
  authProvider     String?
  dni              String?            @unique
  dniVerified      Boolean            @default(false)
  dniVerifiedAt    DateTime?
  reniecCodigoVerificacion String?
  reniecNombres String?
  reniecApellidoPaterno String?
  reniecApellidoMaterno String?
  reniecNombreCompleto String?
  reniecDepartamento String?
  reniecProvincia String?
  reniecDistrito String?
  reniecDireccion String?
  reniecDireccionCompleta String?
  reniecUbigeoReniec String?
  reniecUbigeoSunat String?
  reniecUbigeo Json?
  phone String?
  bio String?
  specialty String?
  experienceYears Int?
  serviceArea String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  clientRequests   TechnicalRequest[] @relation("ClientRequests")
  assignedRequests TechnicalRequest[] @relation("TechnicianRequests")
  comments         RequestComment[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@index([email])
  @@index([role])
}

model ServiceCategory {
  id          String             @id @default(cuid())
  name        String
  description String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  requests    TechnicalRequest[]
}

model TechnicalRequest {
  id           String           @id @default(cuid())
  title        String
  description  String
  priority     RequestPriority  @default(MEDIA)
  status       RequestStatus    @default(PENDIENTE)
  clientId     String
  technicianId String?
  categoryId   String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  acceptedAt   DateTime?
  client       User             @relation("ClientRequests", fields: [clientId], references: [id])
  technician   User?            @relation("TechnicianRequests", fields: [technicianId], references: [id])
  category     ServiceCategory  @relation(fields: [categoryId], references: [id])
  comments     RequestComment[]

  @@index([status])
  @@index([priority])
  @@index([clientId])
  @@index([technicianId])
  @@index([categoryId])
  @@index([createdAt])
}

model RequestComment {
  id        String           @id @default(cuid())
  content   String
  requestId String
  authorId  String
  createdAt DateTime         @default(now())
  request   TechnicalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id])

  @@index([requestId])
  @@index([authorId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model CompanySettings {
  id             String   @id @default(cuid())
  assignmentMode String   @default("MANUAL") // MANUAL | SELF_ASSIGNMENT | AUTO
  maxActiveJobs  Int      @default(3)        // Regla anti-cherry picking: límite de trabajos activos por técnico
  updatedAt      DateTime @updatedAt
}
